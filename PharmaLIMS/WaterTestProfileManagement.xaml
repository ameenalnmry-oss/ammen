<Window x:Class="PharmaLIMS.WaterTestProfileManagement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:PharmaLIMS.Infrastructure"
        Title="Controlled Water Test Profiles"
        Width="1420"
        Height="860"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="CanResizeWithGrip"
        infra:WindowUsability.EnableResponsiveEntry="True"
        Background="#EEF2F7"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#12395A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D8E0EA"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        </Style>
        <Style x:Key="GrayButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#64748B"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,18" CornerRadius="0,0,18,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" Background="White" CornerRadius="13" Margin="0,0,15,0">
                    <TextBlock Text="W" Foreground="{StaticResource PrimaryBrush}" FontSize="18" FontWeight="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Controlled Water Test Profiles" Foreground="White" FontWeight="Bold" FontSize="24"/>
                    <TextBlock Text="Versioned PW / PTW test assignments and specifications for future direct Water registrations."
                               Foreground="#D7E9FA" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#DBEAFE" CornerRadius="16" Padding="14,8" VerticalAlignment="Center">
                    <TextBlock x:Name="lblHeaderStatus" Text="No profile loaded" Foreground="#12395A" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                    CornerRadius="12" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Controlled Water master data — source-backed helpers; Review and Approval remain mandatory" Foreground="#9A3412"
                               FontWeight="Bold" FontSize="13"/>
                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#7C2D12"
                               Text="Use the current approved Water Analysis SOP and any formally adopted corporate/drinking-water guideline. The MQC-G-0018 v2.0 helper prepares PW/PTW tests and limits from that SOP; the CTG-11-02 helper adds the PTW contaminant appendix only when that guideline is still applicable at the site. Helpers never save, review, approve, or activate automatically. Authoring uses Settings permission; Review uses Review permission; Approval uses Approval permission, with the configured Admin override permitted only in Development."/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="16" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Profile Code" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="cboProfileCode" SelectionChanged="CboProfileCode_SelectionChanged">
                            <ComboBoxItem Content="PW" Tag="PW"/>
                            <ComboBoxItem Content="PTW" Tag="PTW"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Profile Name" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtProfileName"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="4">
                        <TextBlock Text="Version / State" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtVersionState" IsReadOnly="True" Background="#F8FAFC"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Effective From *" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="dpEffectiveFrom" Height="38"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Effective To" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="dpEffectiveTo" Height="38"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="4">
                        <TextBlock Text="Controlled Reference *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtControlledReference" ToolTip="Example: approved specification/SOP identifier, revision and effective date."/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,10">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Profile Tests and Specifications" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Numeric limits are optional when the approved specification is qualitative; Specification Text is required for every selected test."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="lblSelectedTests" DockPanel.Dock="Right" Text="Selected: 0"
                                   FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DataGrid x:Name="dgTests"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              RowHeaderWidth="0"
                              CellEditEnding="DgTests_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Use" Width="55"
                                Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Test ID" Width="70" IsReadOnly="True"
                                Binding="{Binding TestID}"/>
                            <DataGridTextColumn Header="Test" Width="190" IsReadOnly="True"
                                Binding="{Binding TestName}"/>
                            <DataGridTextColumn Header="Category" Width="115" IsReadOnly="True"
                                Binding="{Binding TestCategory}"/>
                            <DataGridTextColumn Header="Unit" Width="95" IsReadOnly="True"
                                Binding="{Binding Unit}"/>
                            <DataGridTextColumn Header="Lower" Width="85"
                                Binding="{Binding LowerLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Upper" Width="85"
                                Binding="{Binding UpperLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Alert" Width="85"
                                Binding="{Binding AlertLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Action" Width="85"
                                Binding="{Binding ActionLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Specification Text *" Width="2*"
                                Binding="{Binding SpecificationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" x:Name="lblStatus" Text="Ready" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap"/>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,14">
            <Grid>
                <TextBlock x:Name="lblWorkflowNote" Text="Create or load a Draft to configure controlled master data."
                           VerticalAlignment="Center" Foreground="#64748B" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnNewDraft" Content="New Draft" Click="BtnNewDraft_Click" Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="BtnLoadDevTemplate" Content="Load MQC-G-0018" Click="BtnLoadDevTemplate_Click"
                            Style="{StaticResource WarningButton}" MinWidth="150" Visibility="Collapsed"/>
                    <Button x:Name="BtnLoadFullDevInventory" Content="Add CTG-11-02 PTW" Click="BtnLoadFullDevInventory_Click"
                            Style="{StaticResource WarningButton}" MinWidth="165" Visibility="Collapsed"/>
                    <Button x:Name="BtnSaveDraft" Content="Save Draft" Click="BtnSaveDraft_Click" Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="BtnReview" Content="Review" Click="BtnReview_Click" Style="{StaticResource WarningButton}"/>
                    <Button x:Name="BtnApprove" Content="Approve &amp; Activate" Click="BtnApprove_Click" Style="{StaticResource SuccessButton}" MinWidth="170"/>
                    <Button Content="Reload" Click="BtnReload_Click" Style="{StaticResource GrayButton}"/>
                    <Button Content="Close" Click="BtnClose_Click" Style="{StaticResource GrayButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
