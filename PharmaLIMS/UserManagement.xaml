<Window x:Class="PharmaLIMS.UserManagement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:PharmaLIMS.Infrastructure"
        Title="PharmaLIMS User Management"
        Width="1240" Height="820" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterOwner" WindowState="Maximized" ResizeMode="CanResizeWithGrip"
        infra:WindowUsability.EnableResponsiveEntry="True"
        Background="#F4F7FA"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,18,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#14233A" CornerRadius="12" Padding="20,16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="User Management" Foreground="White" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="Create named accounts and assign controlled PharmaLIMS permissions. Usernames remain immutable after creation for traceability."
                               Foreground="#C9D7E5" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="lblCurrentManager" Foreground="White" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock Text="Changes require Electronic Signature" Foreground="#C9D7E5" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D8E2EA" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Users" FontSize="17" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="Select an account to view or change its role and permissions." FontSize="10.5" Foreground="#64748B"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnRefresh" Content="Refresh" Click="BtnRefresh_Click" Background="#475569" Foreground="White" Margin="10,0,0,0"/>
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="GridUsers"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="#F8FAFC"
                              SelectionChanged="GridUsers_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="130"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/>
                            <DataGridCheckBoxColumn Header="Locked" Binding="{Binding IsLocked}" Width="65"/>
                            <DataGridCheckBoxColumn Header="Change PW" Binding="{Binding MustChangePassword}" Width="82"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Background="White" BorderBrush="#D8E2EA" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="lblEditorTitle" Text="New User" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock x:Name="lblAccountState" Text="Create a named PharmaLIMS account." FontSize="10.5" Foreground="#64748B" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnNew" Content="New User" Click="BtnNew_Click" Background="#176B87" Foreground="White" Margin="10,0,0,0"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Username *" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox x:Name="TxtUsername" MaxLength="100"/>
                                <TextBlock Text="Full Name *" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox x:Name="TxtFullName" MaxLength="200"/>
                                <TextBlock Text="Department" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox x:Name="TxtDepartment" MaxLength="150"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Role *" FontWeight="SemiBold" Foreground="#334155"/>
                                <ComboBox x:Name="CboRole" IsEditable="False">
                                    <ComboBoxItem Content="Admin"/>
                                    <ComboBoxItem Content="Administrator"/>
                                    <ComboBoxItem Content="Technician"/>
                                    <ComboBoxItem Content="Supervisor"/>
                                    <ComboBoxItem Content="QA"/>
                                    <ComboBoxItem Content="Quality Assurance"/>
                                </ComboBox>
                                <TextBlock Text="Section" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBox x:Name="TxtSection" MaxLength="150"/>
                                <TextBlock Text="Account Status" FontWeight="SemiBold" Foreground="#334155"/>
                                <CheckBox x:Name="ChkActive" Content="Active account" IsChecked="True" Margin="0,10,0,10"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,2,0,14">
                            <TextBlock Text="Note: QA-only approval/closure gates require Role = QA (or Quality Assurance) in addition to the corresponding permission. Role labels do not automatically grant permissions."
                                       TextWrapping="Wrap" Foreground="#1E3A8A" FontSize="10.5"/>
                        </Border>

                        <TextBlock Text="Permissions" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <CheckBox x:Name="ChkAccessWater" Content="Access Water"/>
                            <CheckBox x:Name="ChkAccessEM" Content="Access Environmental Monitoring"/>
                            <CheckBox x:Name="ChkRegisterSamples" Content="Register Samples"/>
                            <CheckBox x:Name="ChkEnterResults" Content="Enter Results"/>
                            <CheckBox x:Name="ChkReviewResults" Content="Review Results"/>
                            <CheckBox x:Name="ChkApproveResults" Content="Approve Results"/>
                            <CheckBox x:Name="ChkIssueCOA" Content="Issue COA / Reports"/>
                            <CheckBox x:Name="ChkCancelCOA" Content="Cancel / Reissue COA"/>
                            <CheckBox x:Name="ChkAccessReports" Content="Access Reports &amp; Trends"/>
                            <CheckBox x:Name="ChkManageUsers" Content="Manage Users"/>
                            <CheckBox x:Name="ChkManageSettings" Content="Manage Settings"/>
                        </UniformGrid>

                        <Separator Margin="0,4,0,14"/>
                        <TextBlock Text="Password" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="New users and administrative resets receive a temporary password and must change it at their next sign-in before accessing the workspace or using Electronic Signature. Minimum 12 characters with upper-case, lower-case, number, and special character. Password values are never written to the audit trail."
                                   TextWrapping="Wrap" FontSize="10.5" Foreground="#64748B" Margin="0,3,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#334155"/>
                                <PasswordBox x:Name="PwdPassword"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Confirm Password" FontWeight="SemiBold" Foreground="#334155"/>
                                <PasswordBox x:Name="PwdConfirm"/>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="BtnSave" Content="Save User" Click="BtnSave_Click" Background="#166534" Foreground="White"/>
                            <Button x:Name="BtnResetPassword" Content="Reset Password" Click="BtnResetPassword_Click" Background="#B45309" Foreground="White"/>
                            <Button x:Name="BtnUnlock" Content="Unlock Account" Click="BtnUnlock_Click" Background="#7C3AED" Foreground="White"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#E8F2F6" CornerRadius="8" Padding="12,9" Margin="0,14,0,0">
            <TextBlock x:Name="LblStatus" Text="Ready." Foreground="#155E75" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
