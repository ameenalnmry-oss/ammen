<Window x:Class="PharmaLIMS.EMTrendReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:PharmaLIMS.Infrastructure"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Environmental Monitoring Trend Review" Height="780" Width="1380"
        MinHeight="650" MinWidth="1100" WindowStartupLocation="CenterOwner"
        WindowState="Maximized" ResizeMode="CanResizeWithGrip"
        infra:WindowUsability.EnableResponsiveEntry="True"
        Background="#EEF3F7" FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#103B5B" CornerRadius="10" Padding="18">
            <StackPanel>
                <TextBlock Text="Environmental Monitoring Trend Review" Foreground="White" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Frozen historical area/limit context, total and fungal counts, excursions, completeness and controlled narrative" Foreground="#C8DCE8" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#D8E2EA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="From" VerticalAlignment="Center" Margin="4" FontWeight="SemiBold"/>
                <DatePicker x:Name="dpFrom" Width="150" Height="34" Margin="4"/>
                <TextBlock Text="To" VerticalAlignment="Center" Margin="14,4,4,4" FontWeight="SemiBold"/>
                <DatePicker x:Name="dpTo" Width="150" Height="34" Margin="4"/>
                <CheckBox x:Name="chkApprovedOnly" Content="Approved events only" IsChecked="True" VerticalAlignment="Center" Margin="18,4"/>
                <Button Content="Load Trend" Width="120" Height="36" Margin="8,4" Background="#176B87" Foreground="White" BorderThickness="0" Click="Load_Click"/>
            </WrapPanel>
        </Border>
        <TabControl Grid.Row="2">
            <TabItem Header="Summary by Area / Method">
                <DataGrid x:Name="gridSummary" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          SelectionMode="Single" SelectionChanged="GridSummary_SelectionChanged"/>
            </TabItem>
            <TabItem Header="Trend Chart">
                <Grid Background="White">
                    <oxy:PlotView x:Name="TrendChart" Margin="8"/>
                </Grid>
            </TabItem>
            <TabItem Header="All Individual Observations">
                <DataGrid x:Name="gridDetails" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"/>
            </TabItem>
            <TabItem Header="QA / SOP Trend Narrative">
                <TextBox x:Name="txtNarrative" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Arial" FontSize="13" Padding="14" Background="White" BorderThickness="0"/>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="lblStatus" VerticalAlignment="Center" Foreground="#334E68" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Print Review Draft" Width="125" Height="36" Margin="6,0" Click="Print_Click"/>
                <Button Content="Close" Width="90" Height="36" Margin="6,0" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
