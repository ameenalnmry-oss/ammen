<Window x:Class="PharmaLIMS.ReportsTrends"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:infra="clr-namespace:PharmaLIMS.Infrastructure"
        Title="Reports and Trends - PharmaLIMS"
        Height="850"
        Width="1200"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" ResizeMode="CanResizeWithGrip"
        infra:WindowUsability.EnableResponsiveEntry="True"
        Background="#F8FAFC">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#E67E22"
                Padding="10"
                Margin="0,0,0,15"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Reports and Trends Analysis"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Internal EM Trend Review"
                            Click="OpenInternalEMTrend_Click"
                            Padding="16,7"
                            Margin="0,0,8,0"
                            Background="#123F5F"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderBrush="White"
                            BorderThickness="1"/>
                    <Button Content="External EM Review / Import"
                            Click="OpenEMTrend_Click"
                            Padding="16,7"
                            Background="White"
                            Foreground="#9A4E0B"
                            FontWeight="Bold"
                            BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter Section -->
        <GroupBox Header="Filter Data"
                  Grid.Row="1"
                  Margin="10"
                  Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <!-- Row 0 -->
                <TextBlock x:Name="lblEntityFilter" Text="Sampling Point / Area:"
                           Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="cboPoint"
                          Grid.Row="0"
                          Grid.Column="1"
                          Height="30"
                          SelectedIndex="0">
                    <ComboBoxItem Content="All Sampling Points"
                                  Tag="-1"
                                  IsSelected="True"/>
                </ComboBox>

                <TextBlock Text="Sample Source / Test Category:"
                           Grid.Row="0"
                           Grid.Column="2"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="cboCategory"
                          Grid.Row="0"
                          Grid.Column="3"
                          Height="30"
                          SelectedIndex="0"
                          SelectionChanged="CboCategory_SelectionChanged">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="Physical"/>
                    <ComboBoxItem Content="Chemical"/>
                    <ComboBoxItem Content="Microbiological"/>
                    <ComboBoxItem Content="Raw Material"/>
                    <ComboBoxItem Content="Production / In-Process"/>
                    <ComboBoxItem Content="Finished Product"/>
                    <ComboBoxItem Content="Stability"/>
                </ComboBox>

                <TextBlock Text="Test Name:"
                           Grid.Row="0"
                           Grid.Column="4"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="cboTest"
                          Grid.Row="0"
                          Grid.Column="5"
                          Height="30"
                          DisplayMemberPath="TestName"
                          SelectedValuePath="TestID"
                          IsEnabled="False"/>

                <TextBlock Text="View Mode:"
                           Grid.Row="0"
                           Grid.Column="6"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="cboViewMode"
                          Grid.Row="0"
                          Grid.Column="7"
                          Height="30"
                          SelectedIndex="0"
                          SelectionChanged="CboViewMode_SelectionChanged">
                    <ComboBoxItem Content="Trend by Test"/>
                    <ComboBoxItem Content="Status Summary"/>
                    <ComboBoxItem Content="Category Summary"/>
                </ComboBox>

                <!-- Row 1 -->
                <TextBlock Text="Date From:"
                           Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"/>

                <DatePicker x:Name="dpDateFrom"
                            Grid.Row="1"
                            Grid.Column="1"
                            Height="30"/>

                <TextBlock Text="Date To:"
                           Grid.Row="1"
                           Grid.Column="2"
                           VerticalAlignment="Center"/>

                <DatePicker x:Name="dpDateTo"
                            Grid.Row="1"
                            Grid.Column="3"
                            Height="30"/>

                <Button x:Name="BtnLoadData"
                        Content="Load Data"
                        Grid.Row="1"
                        Grid.Column="4"
                        Width="120"
                        Height="32"
                        Margin="10,0,0,0"
                        Click="BtnLoadData_Click"
                        Background="#3498DB"
                        Foreground="White"/>

                <Button x:Name="BtnClearFilters"
                        Content="Clear Filters"
                        Grid.Row="1"
                        Grid.Column="5"
                        Width="100"
                        Height="32"
                        Margin="10,0,0,0"
                        Click="BtnClearFilters_Click"
                        Background="#64748B"
                        Foreground="White"/>

                <!-- Row 2 -->
                <TextBlock Text="Chart Type:"
                           Grid.Row="2"
                           Grid.Column="0"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="cboChartType"
                          Grid.Row="2"
                          Grid.Column="1"
                          Height="30"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Line Chart"/>
                    <ComboBoxItem Content="Column Chart"/>
                    <ComboBoxItem Content="Pie Chart"/>
                </ComboBox>

                <CheckBox x:Name="chkShowLimits"
                          Grid.Row="2"
                          Grid.Column="3"
                          Content="Show Alert/Action Limits"
                          IsChecked="True"
                          Checked="LimitsVisibilityChanged"
                          Unchecked="LimitsVisibilityChanged"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          IsEnabled="False"/>
            </Grid>
        </GroupBox>

        <!-- Chart Section -->
        <GroupBox Header="Trend Chart"
                  Grid.Row="2"
                  Margin="10"
                  Padding="5"
                  MinHeight="300">
            <oxy:PlotView x:Name="TrendChart"/>
        </GroupBox>

        <!-- Results Grid -->
        <GroupBox Header="Data Table"
                  Grid.Row="3"
                  Margin="10"
                  Padding="5">
            <DataGrid x:Name="dgTrends"
                      AutoGenerateColumns="True"
                      Margin="5"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"/>
        </GroupBox>

        <!-- Summary Cards -->
        <Border Grid.Row="4"
                Background="#F1F5F9"
                CornerRadius="8"
                Padding="10"
                Margin="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#10B981"
                        CornerRadius="6"
                        Padding="8"
                        Margin="3">
                    <TextBlock x:Name="lblPassCount"
                               Text="PASS: 0"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Column="1"
                        Background="#F59E0B"
                        CornerRadius="6"
                        Padding="8"
                        Margin="3">
                    <TextBlock x:Name="lblAlertCount"
                               Text="ALERT: 0"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Column="2"
                        Background="#EF4444"
                        CornerRadius="6"
                        Padding="8"
                        Margin="3">
                    <TextBlock x:Name="lblFailCount"
                               Text="FAIL: 0"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Column="3"
                        Background="#3B82F6"
                        CornerRadius="6"
                        Padding="8"
                        Margin="3">
                    <TextBlock x:Name="lblTotalSamples"
                               Text="Samples: 0"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Column="4"
                        Background="#8B5CF6"
                        CornerRadius="6"
                        Padding="8"
                        Margin="3">
                    <TextBlock x:Name="lblTotalResults"
                               Text="Results: 0"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Column="5"
                        Background="#64748B"
                        CornerRadius="6"
                        Padding="8"
                        Margin="3">
                    <TextBlock x:Name="lblTestTypes"
                               Text="Test Types: 0"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="10">
            <Button x:Name="BtnExportChart"
                    Content="Export Chart"
                    Width="120"
                    Height="35"
                    Margin="10"
                    Click="BtnExportChart_Click"
                    Background="#8B5CF6"
                    Foreground="White"
                    FontWeight="Bold"/>

            <Button x:Name="BtnExportPDF"
                    Content="Export PDF"
                    Width="120"
                    Height="35"
                    Margin="10"
                    Click="BtnExportPDF_Click"
                    Background="#DC2626"
                    Foreground="White"
                    FontWeight="Bold"/>

            <Button x:Name="BtnExportCSV"
                    Content="Export to CSV"
                    Width="120"
                    Height="35"
                    Margin="10"
                    Click="BtnExport_Click"
                    Background="#27AE60"
                    Foreground="White"
                    FontWeight="Bold"/>
        </StackPanel>

        <!-- Status -->
        <StatusBar Grid.Row="6"
                   VerticalAlignment="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus"
                           Text="Ready"
                           Foreground="#64748B"
                           FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
