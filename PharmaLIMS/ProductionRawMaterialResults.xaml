<Window x:Class="PharmaLIMS.ProductionRawMaterialResults"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:PharmaLIMS.Infrastructure"
        Title="Production / Raw Material LIMS Results Entry"
        Height="900"
        Width="1400"
        MinHeight="760"
        MinWidth="1180"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" ResizeMode="CanResizeWithGrip"
        infra:WindowUsability.EnableResponsiveEntry="True"
        Background="#F8FAFC">

    <Window.Resources>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ReadOnlyBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#EEF2F7"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172033" CornerRadius="18" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Production / Raw Material / Finished Product / Stability Results Entry"
                               Foreground="White" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="LIMS workflow: Start Analysis → Save Results → Submit Review → Review → Approve → Issue Certificate / Report."
                               Foreground="#CBD5E1" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCurrentUser" Text="User:" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TxtSelectedSampleHeader" Text="No sample selected" Foreground="#CBD5E1" FontSize="12" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid x:Name="ChoiceView" Visibility="Visible">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="28">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Choose Sample Type" FontSize="30" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select the results workflow. Finished Product is included under Production Samples."
                                   FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,38"/>

                        <UniformGrid Columns="3" HorizontalAlignment="Stretch">
                            <Button x:Name="BtnChooseProductionResults" Click="BtnChooseProductionResults_Click" Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" Cursor="Hand" MinHeight="180" Margin="12">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="22">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <StackPanel>
                                        <Border Background="#2563EB" Width="70" Height="70" CornerRadius="14" HorizontalAlignment="Left">
                                            <TextBlock Text="PR" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Production Samples" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,24,0,6"/>
                                        <TextBlock Text="Production / In-Process and Finished Product results" TextWrapping="Wrap" FontSize="13" Foreground="#475569"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button x:Name="BtnChooseRawResults" Click="BtnChooseRawResults_Click" Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" Cursor="Hand" MinHeight="180" Margin="12">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="22">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <StackPanel>
                                        <Border Background="#0F766E" Width="70" Height="70" CornerRadius="14" HorizontalAlignment="Left">
                                            <TextBlock Text="RM" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Raw Material Samples" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,24,0,6"/>
                                        <TextBlock Text="Raw material microbiology results and certificate" TextWrapping="Wrap" FontSize="13" Foreground="#475569"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button x:Name="BtnChooseStabilityResults" Click="BtnChooseStabilityResults_Click" Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" Cursor="Hand" MinHeight="180" Margin="12">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="22">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <StackPanel>
                                        <Border Background="#7C3AED" Width="70" Height="70" CornerRadius="14" HorizontalAlignment="Left">
                                            <TextBlock Text="ST" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Stability Samples" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,24,0,6"/>
                                        <TextBlock Text="Long-term, accelerated, and intermediate pull point results" TextWrapping="Wrap" FontSize="13" Foreground="#475569"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ResultsView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <Button x:Name="BtnBackToType" Content="←" Width="34" Height="30" Margin="0,0,8,0" Background="#475569" Foreground="White" BorderThickness="0" Click="BtnBackToType_Click"/>
                            <TextBlock x:Name="TxtSamplesTitle" Text="Samples" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSearch" Grid.Column="0" Style="{StaticResource InputBox}" KeyDown="TxtSearch_KeyDown"
                                     infra:WindowUsability.KeepEnterBehavior="True"
                                     ToolTip="Search by sample number, product, material, lot, or batch"/>
                            <Button x:Name="BtnSearch" Grid.Column="1" Content="Search" Background="#2563EB" Style="{StaticResource ActionButton}" Click="BtnSearch_Click"/>
                        </Grid>

                        <DataGrid x:Name="DgSamples" Grid.Row="2"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  SelectionChanged="DgSamples_SelectionChanged"
                                  RowHeight="34" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderBrush="#CBD5E1" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sample No." Binding="{Binding SampleNumber}" Width="125"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding SampleCategory}" Width="145"/>
                                <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="180"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding SampleStatus}" Width="125"/>
                                <DataGridTextColumn Header="Report" Binding="{Binding ReportStatus}" Width="115"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="LIMS Workflow Actions" Style="{StaticResource HeaderText}"/>
                            <WrapPanel x:Name="WorkflowActionsPanel"
                                       Grid.Row="1"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Left">
                                <Button x:Name="BtnStartAnalysis" Content="Start Analysis" Background="#0F766E" Style="{StaticResource ActionButton}" Click="BtnStartAnalysis_Click"/>
                                <Button x:Name="BtnTimingReconciliation" Content="QA Timing Reconciliation" Background="#9A3412" Style="{StaticResource ActionButton}" Click="BtnTimingReconciliation_Click" ToolTip="Enabled only when migration identifies legacy PRM timing evidence that requires controlled re-entry and QA reconciliation."/>
                                <Button x:Name="BtnSaveResults" Content="Save Results" Background="#16A34A" Style="{StaticResource ActionButton}" Click="BtnSaveResults_Click"/>
                                <Button x:Name="BtnSubmitReview" Content="Submit Review" Background="#EA580C" Style="{StaticResource ActionButton}" Click="BtnSubmitReview_Click"/>
                                <Button x:Name="BtnReview" Content="Review" Background="#7C3AED" Style="{StaticResource ActionButton}" Click="BtnReview_Click"/>
                                <Button x:Name="BtnApprove" Content="Approve" Background="#15803D" Style="{StaticResource ActionButton}" Click="BtnApprove_Click"/>
                                <Button x:Name="BtnQualityEvent" Content="Investigation" Background="#B45309" Style="{StaticResource ActionButton}" Click="BtnQualityEvent_Click"
                                        ToolTip="Open, continue, or view the PRM Quality Event investigation"/>
                                <Button x:Name="BtnIssueCertificate" Content="Issue Certificate" Background="#1D4ED8" Style="{StaticResource ActionButton}" Click="BtnIssueCertificate_Click"/>
                                <Button x:Name="BtnPrintCertificate" Content="Open Controlled Certificate" Background="#334155" Style="{StaticResource ActionButton}" Click="BtnPrintCertificate_Click"/>
                                <Button x:Name="BtnPreviewCurrentLayout" Content="Preview Current Layout" Background="#D97706" Style="{StaticResource ActionButton}" Click="BtnPreviewCurrentLayout_Click"
                                        ToolTip="Preview the current report template with a permanent PREVIEW watermark. The issued immutable snapshot is not changed."/>
                                <Button x:Name="BtnCancelCertificate" Content="Cancel Certificate" Background="#DC2626" Style="{StaticResource ActionButton}" Click="BtnCancelCertificate_Click"/>
                                <Button x:Name="BtnReissueCertificate" Content="Reissue" Background="#9333EA" Style="{StaticResource ActionButton}" Click="BtnReissueCertificate_Click"/>
                            </WrapPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                                    <TextBlock Text="Sample No." Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="TxtSampleNo" Style="{StaticResource ReadOnlyBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,10">
                                    <TextBlock Text="Category" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="TxtCategory" Style="{StaticResource ReadOnlyBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,10">
                                    <TextBlock Text="Item / Product" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="TxtItemName" Style="{StaticResource ReadOnlyBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,10">
                                    <TextBlock Text="Lot / Batch" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="TxtLotBatch" Style="{StaticResource ReadOnlyBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Sample Status" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="TxtSampleStatus" Style="{StaticResource ReadOnlyBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="Overall Result" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="TxtOverallInterpretation" Style="{StaticResource ReadOnlyBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock Text="Certificate / Report Status" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="TxtReportStatus" Style="{StaticResource ReadOnlyBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="3">
                                    <TextBlock Text="Active Certificate No." Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="TxtCertificateNo" Style="{StaticResource ReadOnlyBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,12,0">
                                    <TextBlock Text="Quality Event No." Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="TxtQualityEventNo" Style="{StaticResource ReadOnlyBox}" Text="None"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,10,12,0">
                                    <TextBlock Text="Investigation Status" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="TxtInvestigationStatus" Style="{StaticResource ReadOnlyBox}" Text="Not Required"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                    <TextBlock Text="Investigation Disposition" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="TxtInvestigationDisposition" Style="{StaticResource ReadOnlyBox}" Text="—"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tests are loaded only from the approved specification master linked to the sample. Edit Result and Remarks, then Save Results."
                                           Foreground="#1E3A8A" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <Button x:Name="BtnReloadTests" Grid.Column="1" Content="Load Approved Tests" Background="#2563EB" Style="{StaticResource ActionButton}" Click="BtnReloadTests_Click"/>
                            </Grid>
                        </Border>

                        <Border x:Name="CertificateReasonPanel" Grid.Row="3"
                                Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1"
                                CornerRadius="12" Padding="10" Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cancellation / Reissue Reason" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCertificateReason" Grid.Column="1" MaxLength="500" Style="{StaticResource InputBox}" ToolTip="Required when cancelling or reissuing a certificate/report. When routed from signed legacy reconciliation, the signed QA reason is prefilled automatically."/>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="DgResults" Grid.Row="4"
                                  AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single"
                                  RowHeight="36" MinHeight="260" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  BorderBrush="#CBD5E1" BorderThickness="1" CanUserAddRows="False" CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="2*" MinWidth="180" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Specification" Binding="{Binding SpecificationText}" Width="2.2*" MinWidth="180" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding ResultValue, UpdateSourceTrigger=PropertyChanged}" Width="1*" MinWidth="90"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="0.8*" MinWidth="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding ResultType}" Width="1*" MinWidth="95" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Min h" Binding="{Binding MinimumElapsedHours, StringFormat=0.##}" Width="0.7*" MinWidth="65" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Eligible At" Binding="{Binding EligibleAtText}" Width="1.25*" MinWidth="130" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Timing" Binding="{Binding TimingStatus}" Width="0.9*" MinWidth="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Interpretation" Binding="{Binding Interpretation}" Width="1.2*" MinWidth="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Width="1.4*" MinWidth="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#EEF2F7" CornerRadius="12" Padding="10" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Ready." Foreground="#334155" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Microbiology certificate/report only. Final batch/material disposition remains outside this screen."
                           Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
