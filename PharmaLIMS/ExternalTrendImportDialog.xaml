<Window x:Class="PharmaLIMS.ExternalTrendImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:PharmaLIMS.Infrastructure"
        Title="Controlled External Trend Import"
        Width="1280"
        Height="820"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterOwner" WindowState="Maximized" ResizeMode="CanResizeWithGrip"
        infra:WindowUsability.EnableResponsiveEntry="True"
        Background="#F1F5F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#123F5F" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Controlled External Trend Import"
                               FontSize="25" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="CSV/XLSX staging, independent approval, source-file integrity, and trend analysis"
                               Margin="0,5,0,0" FontSize="13" Foreground="#D7E8F4"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#D8ECF8" CornerRadius="18" Padding="15,7" VerticalAlignment="Center">
                    <TextBlock Text="READ-ONLY ANALYTICS SOURCE" FontWeight="Bold" Foreground="#123F5F"/>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="14" x:Name="tabImport">
            <TabItem Header="New Import">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="145"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="7" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Module *" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cboModule" Grid.Row="0" Grid.Column="1" Height="31" SelectionChanged="ModuleSelectionChanged">
                                <ComboBoxItem Content="Water"/>
                                <ComboBoxItem Content="Environmental Monitoring"/>
                            </ComboBox>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Source System *" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtSourceSystem" Grid.Row="0" Grid.Column="3" Height="31" Padding="7,4"/>
                            <TextBox x:Name="txtFilePath" Grid.Row="0" Grid.Column="4" Margin="14,0,8,0" Height="31"
                                     IsReadOnly="True" Padding="7,4" ToolTip="Selected controlled source file"/>
                            <Button Grid.Row="0" Grid.Column="5" Content="Select File" Click="SelectFile_Click"
                                    Width="105" Height="32" Margin="0,0,8,0" Background="#2563EB" Foreground="White" FontWeight="Bold"/>
                            <Button Grid.Row="0" Grid.Column="6" Content="Download Template" Click="DownloadTemplate_Click"
                                    Width="145" Height="32" Background="#E2E8F0" Foreground="#0F172A"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Import Reason *" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtImportReason" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6" Height="31"
                                     Padding="7,4" TextChanged="ImportReason_TextChanged"
                                     ToolTip="Document why this external dataset is being introduced for trend analysis. At least 10 characters are required."/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="0,10,0,10" Padding="12" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblPreviewSummary" Text="Select a CSV or XLSX file. EM also requires AreaClassification (Classified or Unclassified)."
                                       Foreground="#1E3A8A" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="btnStage" Grid.Column="1" Content="Stage for Approval" Click="StageImport_Click"
                                    Width="165" Height="36" Margin="15,0,0,0" Background="#15803D" Foreground="White"
                                    FontWeight="Bold" IsEnabled="False"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="dgPreview" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="All"
                              GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8FAFC"/>

                    <GroupBox Grid.Row="3" Header="Validation Findings" Margin="0,10,0,0" Padding="7">
                        <ListBox x:Name="lstIssues" DisplayMemberPath="DisplayText"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Approval and Analysis">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgHistory" Grid.Row="0" AutoGenerateColumns="True" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                              SelectionChanged="HistorySelectionChanged" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8FAFC"/>

                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" Background="White"
                            BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="44"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblHistorySelection" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="9" Margin="0,0,0,8"
                                       Text="Select an import batch." Foreground="#475569" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Method" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cboMethod" Grid.Row="1" Grid.Column="1" Height="32" DisplayMemberPath="MethodName" SelectedValuePath="MethodName" SelectionChanged="HistoryMethodSelectionChanged"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Result / parameter" Margin="12,0,8,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cboParameter" Grid.Row="1" Grid.Column="3" Height="32"/>
                            <Button Grid.Row="1" Grid.Column="5" Content="Refresh" Click="RefreshHistory_Click" Width="90" Height="34" Margin="0,0,8,0"/>
                            <Button Grid.Row="1" Grid.Column="6" Content="Approve" Click="ApproveImport_Click" Width="100" Height="34" Margin="0,0,8,0"
                                    Background="#15803D" Foreground="White" FontWeight="Bold"/>
                            <Button Grid.Row="1" Grid.Column="7" Content="Reject" Click="RejectImport_Click" Width="90" Height="34" Margin="0,0,8,0"
                                    Background="#B91C1C" Foreground="White" FontWeight="Bold"/>
                            <Button Grid.Row="1" Grid.Column="8" Content="Open External Review" Click="AnalyzeImport_Click" Width="185" Height="34"
                                    Background="#0369A1" Foreground="White" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1,1,1,0" Padding="14,9">
            <Grid>
                <TextBlock Text="Imported data is stored separately and never overwrites native LIMS samples or results."
                           Foreground="#475569" VerticalAlignment="Center"/>
                <Button Content="Close" HorizontalAlignment="Right" Width="105" Height="34" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
