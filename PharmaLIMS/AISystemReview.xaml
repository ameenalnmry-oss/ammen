<Window x:Class="PharmaLIMS.AISystemReview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:PharmaLIMS.Infrastructure"
        Title="AI System Review"
        Width="1450" Height="850"
        MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" ResizeMode="CanResizeWithGrip"
        infra:WindowUsability.EnableResponsiveEntry="True"
        Background="#EDF3F7"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Navy" Color="#123F5E"/>
        <SolidColorBrush x:Key="Text" Color="#10243A"/>
        <SolidColorBrush x:Key="Muted" Color="#5E7186"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#176B87"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E3EDF3"/>
            <Setter Property="Foreground" Value="#16364C"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E6EEF4"/>
            <Setter Property="Foreground" Value="#17364D"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="#CAD8E2"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE8EE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="Background" Value="#FDE8EA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="High">
                    <Setter Property="Background" Value="#FFF0E4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Medium">
                    <Setter Property="Background" Value="#FFF8DD"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Low">
                    <Setter Property="Background" Value="#F0F6FA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="112"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Navy}" CornerRadius="0,0,18,18" Padding="26,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AI System Review" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Read-only analysis of configuration, database integrity, GMP workflow, audit controls, logs, and source maintainability."
                               Foreground="#C9DDE9" FontSize="12.5" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#205C7B" CornerRadius="18" Padding="16,8" VerticalAlignment="Center">
                    <TextBlock x:Name="lblReviewContext" Foreground="White" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,18,22,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18,13" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="CRITICAL" Foreground="#8F1D2C" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="lblCritical" Text="0" Foreground="#B91C2B" FontSize="27" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18,13" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="HIGH" Foreground="#A44512" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="lblHigh" Text="0" Foreground="#D35416" FontSize="27" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18,13" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="MEDIUM" Foreground="#92620A" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="lblMedium" Text="0" Foreground="#B7790A" FontSize="27" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="18,13" Margin="0,0,10,0">
                <StackPanel><TextBlock Text="LOW" Foreground="#315C75" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="lblLow" Text="0" Foreground="#176B87" FontSize="27" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="18,13">
                <StackPanel><TextBlock Text="OVERALL STATUS" Foreground="#526A7D" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="lblOverall" Text="Not reviewed" Foreground="#17364D" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="22,0,22,0" Background="White" CornerRadius="14" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,2,4,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Review Findings" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                        <TextBlock x:Name="lblStatus" Text="Run the review to analyze the current system." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="cboSeverityFilter" Grid.Column="1" Width="150" Height="34" SelectedIndex="0" SelectionChanged="CboSeverityFilter_SelectionChanged">
                        <ComboBoxItem Content="All severities" Tag="All"/>
                        <ComboBoxItem Content="Critical" Tag="Critical"/>
                        <ComboBoxItem Content="High" Tag="High"/>
                        <ComboBoxItem Content="Medium" Tag="Medium"/>
                        <ComboBoxItem Content="Low" Tag="Low"/>
                        <ComboBoxItem Content="Information" Tag="Info"/>
                    </ComboBox>
                </Grid>

                <DataGrid x:Name="gridFindings" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderBrush="#D3DFE7" BorderThickness="1"
                          RowHeaderWidth="0"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                        <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="155"/>
                        <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="2*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="8"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="8"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Recommended Action" Binding="{Binding Recommendation}" Width="2*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="8"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="#EAF4F8" CornerRadius="9" Padding="12" Margin="0,12,0,0">
                    <TextBlock Text="AI Review is advisory and read-only. It never changes results, signatures, audit records, certificates, database schema, or source code. All corrections remain subject to human review, build validation, testing, and change control."
                               TextWrapping="Wrap" Foreground="#22516A"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#D5E0E7" BorderThickness="0,1,0,0" Padding="22,13">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="lblLastReview" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnRunReview" Content="Run AI Review" Style="{StaticResource ActionButton}" Click="BtnRunReview_Click"/>
                    <Button x:Name="btnCopyPlan" Content="Copy Fix Plan" Style="{StaticResource SecondaryButton}" Click="BtnCopyPlan_Click" IsEnabled="False"/>
                    <Button x:Name="btnExport" Content="Export Report" Style="{StaticResource SecondaryButton}" Click="BtnExport_Click" IsEnabled="False"/>
                    <Button Content="Close" Width="110" Style="{StaticResource SecondaryButton}" Margin="0" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
