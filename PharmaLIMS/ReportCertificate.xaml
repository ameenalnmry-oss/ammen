<Window x:Class="PharmaLIMS.ReportCertificate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Water Laboratory Document"
        Height="950"
        Width="1200"
        MinWidth="1050"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized" ResizeMode="CanResizeWithGrip"
        Background="White"
        FontFamily="Arial"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Arial"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="Arial"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

        <!-- A4 portrait: 210 x 297 mm at 96 DPI = 793.70 x 1122.52 device-independent pixels -->
        <Border x:Name="PrintableArea"
                Width="793.7"
                MinHeight="1122.52"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                BorderBrush="#1E293B"
                BorderThickness="1"
                Margin="8"
                Padding="18"
                CornerRadius="0"
                Background="White"
                SnapsToDevicePixels="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Company Header -->
                <Border Grid.Row="0"
                        Background="#2C3E50"
                        CornerRadius="5"
                        Padding="9"
                        Margin="0,0,0,5">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="165"/>
                        </Grid.ColumnDefinitions>

                        <!-- Official company logo -->
                        <Border Grid.Column="0"
                                Background="#FFFFFF"
                                CornerRadius="6"
                                Width="120"
                                Height="42"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Padding="6">

                            <Image Source="pack://siteoforigin:,,,/medica-logo.png"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   SnapsToDevicePixels="True"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="MEDICA PHARMACEUTICAL INDUSTRY"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Microbiology Department"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#CBD5E1"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <TextBlock x:Name="lblDocumentNumber"
                                       Text="Document No.: MQC-COA-PW-001"
                                       Foreground="#CBD5E1"
                                       FontSize="10.5"
                                       FontFamily="Arial"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Version: 01"
                                       Foreground="#CBD5E1"
                                       FontSize="10.5"
                                       FontFamily="Arial"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="lblPageInfo"
                                       Text="Page 1 of 1"
                                       Foreground="#CBD5E1"
                                       FontSize="10.5"
                                       FontFamily="Arial"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Certificate Title -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,6">

                    <TextBlock x:Name="lblMainDocumentTitle"
                               Text="CERTIFICATE OF ANALYSIS"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="lblAnalysisReportTitle"
                               Text="PURIFIED WATER"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>

                    <TextBlock x:Name="lblAnalysisReference"
                               Text="Analysis according to MQC-G-0018"
                               FontSize="11.5"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Line Grid.Row="2"
                      X1="0"
                      X2="1000"
                      Y1="0"
                      Y2="0"
                      Stroke="#E2E8F0"
                      StrokeThickness="2"
                      Margin="0,3,0,8"/>

                <!-- Certificate Number -->
                <Border Grid.Row="3"
                        Width="340"
                        Background="White"
                        BorderBrush="#B8C7D9"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Right">

                    <StackPanel>
                        <Border Background="#1E3A5F" CornerRadius="5,5,0,0" Padding="9,6">
                            <TextBlock Text="DOCUMENT INFORMATION"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,8,11,9">
                        <TextBlock x:Name="lblCertificateNumber"
                                   Text="Certificate No: Pending issuance"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#1E3A5F"/>

                        <TextBlock x:Name="lblIssueDate"
                                   Text="Issue Date: Pending issuance"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   HorizontalAlignment="Left"
                                   Margin="0,3,0,0"/>

                        <TextBlock x:Name="lblVerificationCode"
                                   Text="Verification Code: Pending issuance"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   HorizontalAlignment="Left"
                                   Margin="0,3,0,0"/>

                        <TextBlock x:Name="lblRevisionNo"
                                   Text="Revision No: Pending issuance"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   HorizontalAlignment="Right"
                                   Margin="0,3,0,0"/>

                        <TextBlock x:Name="lblCertificateStatus"
                                   Text="Certificate Status: Pending issuance"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   HorizontalAlignment="Right"
                                   Margin="0,3,0,0"/>

                        <TextBlock x:Name="lblReportHash"
                                   Text="Document Hash: Pending issuance"
                                   FontSize="9.8"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   FontFamily="Arial"
                                   HorizontalAlignment="Right"
                                   Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sample Information -->
                <Border Grid.Row="4"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,7">

                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10.8"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </Grid.Resources>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Sample Number:"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="lblSampleNumber"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"
                                   FontFamily="Arial"/>

                        <TextBlock Text="Sample Type:"
                                   Grid.Row="0"
                                   Grid.Column="2"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="lblSampleType"
                                   Grid.Row="0"
                                   Grid.Column="3"
                                   Foreground="#1E293B"/>

                        <TextBlock Text="Sampling Point:"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="lblSamplingPoint"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="3"
                                   Foreground="#1E293B"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Sampling Date / Time:"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="lblSamplingDate"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Foreground="#1E293B"
                                   FontFamily="Arial"/>

                        <TextBlock Text="Collected By:"
                                   Grid.Row="2"
                                   Grid.Column="2"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="lblSampledBy"
                                   Grid.Row="2"
                                   Grid.Column="3"
                                   Foreground="#1E293B"/>

                        <TextBlock Text="Received in Lab:"
                                   Grid.Row="3"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="lblReceivedDate"
                                   Grid.Row="3"
                                   Grid.Column="1"
                                   Foreground="#1E293B"
                                   FontFamily="Arial"/>

                        <TextBlock Text="Status:"
                                   Grid.Row="3"
                                   Grid.Column="2"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <Border x:Name="statusBadge"
                                Grid.Row="3"
                                Grid.Column="3"
                                CornerRadius="12"
                                Padding="10,4"
                                HorizontalAlignment="Left">

                            <TextBlock x:Name="lblStatus"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="11.5"/>
                        </Border>

                        <TextBlock Text="Analysis Started:"
                                   Grid.Row="4"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="lblAnalysisDate"
                                   Grid.Row="4"
                                   Grid.Column="1"
                                   Foreground="#1E293B"
                                   FontFamily="Arial"/>

                        <TextBlock Text="Analysis Completed:"
                                   Grid.Row="4"
                                   Grid.Column="2"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="lblAnalysisCompletedDate"
                                   Grid.Row="4"
                                   Grid.Column="3"
                                   Foreground="#1E293B"
                                   FontFamily="Arial"/>

                        <TextBlock Text="Reviewed Date / Time:"
                                   Grid.Row="5"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="lblReviewedSummaryDate"
                                   Grid.Row="5"
                                   Grid.Column="1"
                                   Foreground="#1E293B"
                                   FontFamily="Arial"/>

                        <TextBlock Text="Approved Date / Time:"
                                   Grid.Row="5"
                                   Grid.Column="2"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="lblApprovedSummaryDate"
                                   Grid.Row="5"
                                   Grid.Column="3"
                                   Foreground="#1E293B"
                                   FontFamily="Arial"/>

                        <TextBlock Text="Specification:"
                                   Grid.Row="6"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="lblSpecification"
                                   Grid.Row="6"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="3"
                                   Text="MQC-G-0018"
                                   Foreground="#10B981"
                                   FontFamily="Arial"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Results Table -->
                <Border Grid.Row="5"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0"
                        Margin="0,0,0,7">

                    <DataGrid x:Name="dgResults"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              RowHeight="31"
                              GridLinesVisibility="All"
                              FontSize="10.2"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False"
                              EnableRowVirtualization="False"
                              EnableColumnVirtualization="False"
                              MinHeight="180">

                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel>
                                                        <Border Background="#EAF0F7"
                                                                BorderBrush="#B8C7D9"
                                                                BorderThickness="0,1,0,1"
                                                                Padding="8,5"
                                                                Margin="0,6,0,0">

                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="#0F172A"
                                                                       FontWeight="Bold"
                                                                       FontSize="11.5"/>
                                                        </Border>

                                                        <ItemsPresenter/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Test Name"
                                                Binding="{Binding TestName}"
                                                Width="2.5*"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Limit"
                                                Binding="{Binding Specification}"
                                                Width="1.6*"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Result"
                                                Binding="{Binding Result}"
                                                Width="1*"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Unit"
                                                Binding="{Binding Unit}"
                                                Width="0.8*"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Conformity"
                                                Binding="{Binding Status}"
                                                Width="1*"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Final Conclusion -->
                <Border x:Name="FinalConclusionBorder"
                        Grid.Row="6"
                        BorderBrush="#A7D7C5"
                        BorderThickness="1.2"
                        Background="#ECFDF5"
                        CornerRadius="6"
                        Padding="11"
                        Margin="0,0,0,8">

                    <StackPanel>
                        <TextBlock Text="FINAL CONCLUSION"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#14532D"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <TextBlock x:Name="lblFinalConclusion"
                                   Text="The tested sample conforms to the approved specification."
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#047857"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Electronic Validity -->
                <Border Grid.Row="7"
                        Background="#F8FAFC"
                        CornerRadius="6"
                        Padding="6"
                        Margin="0,0,0,7">

                    <StackPanel>
                        <TextBlock x:Name="lblElectronicValidityText"
                                   Text="This electronic document is generated and signed within PharmaLIMS. Signature details, date/time, and meaning are shown below."
                                   FontSize="9.8"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>

                        <TextBlock x:Name="lblFooter"
                                   Text=""
                                   FontSize="9.8"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Signatures -->
                <Border Grid.Row="8"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="9"
                        Margin="0,0,0,7">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="ELECTRONIC SIGNATURE"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4"/>

                            <Line X1="0"
                                  X2="120"
                                  Y1="0"
                                  Y2="0"
                                  Stroke="#1E293B"
                                  StrokeThickness="1"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Entered By"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="lblAnalyst"
                                       Text="_________________"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       FontFamily="Arial"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="lblAnalystDate"
                                       Text="Signed: Pending"
                                       FontSize="10.5"
                                       Foreground="#64748B"
                                       FontFamily="Arial"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="lblAnalystRole"
                                       Text="Role: Pending"
                                       FontSize="10.5"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="lblAnalystMeaning"
                                       Text="Meaning: Result Entry"
                                       FontSize="10.5"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="ELECTRONIC SIGNATURE"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4"/>

                            <Line X1="0"
                                  X2="120"
                                  Y1="0"
                                  Y2="0"
                                  Stroke="#1E293B"
                                  StrokeThickness="1"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Reviewed By"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="lblReviewedBy"
                                       Text="_________________"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       FontFamily="Arial"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="lblReviewedDate"
                                       Text="Signed: Pending"
                                       FontSize="10.5"
                                       Foreground="#64748B"
                                       FontFamily="Arial"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="lblReviewedRole"
                                       Text="Role: Pending"
                                       FontSize="10.5"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="lblReviewedMeaning"
                                       Text="Meaning: Technical Review"
                                       FontSize="10.5"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="ELECTRONIC SIGNATURE"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4"/>

                            <Line X1="0"
                                  X2="120"
                                  Y1="0"
                                  Y2="0"
                                  Stroke="#1E293B"
                                  StrokeThickness="1"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Approved By"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="lblApprovedBy"
                                       Text="_________________"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       FontFamily="Arial"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="lblApprovedDate"
                                       Text="Signed: Pending"
                                       FontSize="10.5"
                                       Foreground="#64748B"
                                       FontFamily="Arial"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="lblApprovedRole"
                                       Text="Role: Pending"
                                       FontSize="10.5"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="lblApprovedMeaning"
                                       Text="Meaning: QA Approval"
                                       FontSize="10.5"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="ELECTRONIC SIGNATURE"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4"/>

                            <Line X1="0"
                                  X2="120"
                                  Y1="0"
                                  Y2="0"
                                  Stroke="#1E293B"
                                  StrokeThickness="1"
                                  Margin="0,0,0,8"/>

                            <TextBlock Text="Issued By"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="lblIssuedBy"
                                       Text="_________________"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       FontFamily="Arial"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="lblIssuedDate"
                                       Text="Signed: Pending"
                                       FontSize="10.5"
                                       Foreground="#64748B"
                                       FontFamily="Arial"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="lblIssuedRole"
                                       Text="Role: Pending"
                                       FontSize="10.5"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="lblIssuedMeaning"
                                       Text="Meaning: COA Issuance"
                                       FontSize="10.5"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Verification Information -->
                <Border Grid.Row="9"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="7"
                        Margin="0,0,0,5"
                        HorizontalAlignment="Stretch">

                    <StackPanel>
                        <TextBlock x:Name="lblVerificationTitle"
                                   Text="Certificate Verification"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#475569"
                                   HorizontalAlignment="Left"/>

                        <TextBlock x:Name="lblVerificationStatement"
                                   Text="Verify this document using the verification code and document hash recorded above."
                                   FontSize="9.8"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Right"
                                   Margin="0,3,0,0"/>

                        <TextBlock Text="This report shall not be reproduced except in full."
                                   FontSize="9.8"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Right"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
        </ScrollViewer>

        <!-- Fixed action bar: always visible and excluded from the A4 printable area. -->
        <Border Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel x:Name="ActionButtonsPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                    <Button x:Name="BtnIssueCertificate"
                            Content="Issue Certificate"
                            Width="130"
                            Height="35"
                            Margin="8,0"
                            Click="BtnIssueCertificate_Click"
                            Background="#1E3A5F"
                            Foreground="White"
                            FontWeight="Bold"/>

                    <Button x:Name="BtnPrint"
                            Content="Print"
                            Width="100"
                            Height="35"
                            Margin="8,0"
                            Click="BtnPrint_Click"
                            Background="#3B82F6"
                            Foreground="White"
                            FontWeight="Bold"/>

                    <Button x:Name="BtnClose"
                            Content="Close"
                            Width="100"
                            Height="35"
                            Margin="8,0"
                            Click="BtnClose_Click"
                            Background="#EF4444"
                            Foreground="White"
                            FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
