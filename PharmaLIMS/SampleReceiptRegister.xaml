<Window x:Class="PharmaLIMS.SampleReceiptRegister"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Laboratory Sample Register" Width="1280" Height="800" MinWidth="900" MinHeight="600" WindowState="Maximized" WindowStartupLocation="CenterOwner" Background="#F4F6F8">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#143752" Padding="16" CornerRadius="8"><StackPanel>
   <TextBlock Text="MEDICA | LABORATORY SAMPLE REGISTER" Foreground="White" FontSize="23" FontWeight="Bold"/>
   <TextBlock Text="Samples by type, with sampling, laboratory receipt and registration dates shown separately" Foreground="White" Margin="0,5,0,0"/>
  </StackPanel></Border>
  <StackPanel Grid.Row="1" Margin="0,12">
   <WrapPanel VerticalAlignment="Center">
    <StackPanel Margin="0,0,12,8"><TextBlock Text="Sample type"/><ComboBox x:Name="TypeFilter" Width="215" Height="30" SelectionChanged="FilterChanged"/></StackPanel>
    <StackPanel Margin="0,0,12,8"><TextBlock Text="Date basis"/><ComboBox x:Name="DateBasis" Width="250" Height="30" SelectionChanged="FilterChanged"><ComboBoxItem Content="Registration date (all types)"/><ComboBoxItem Content="Lab receipt date (recorded only)"/></ComboBox></StackPanel>
    <StackPanel Margin="0,0,12,8"><TextBlock Text="From"/><DatePicker x:Name="DateFrom" Width="145" Height="30" SelectedDateChanged="FilterChanged"/></StackPanel>
    <StackPanel Margin="0,0,12,8"><TextBlock Text="To (inclusive)"/><DatePicker x:Name="DateTo" Width="145" Height="30" SelectedDateChanged="FilterChanged"/></StackPanel>
    <Button x:Name="LoadButton" Content="Load Register" Click="Load_Click" Padding="14,6" Margin="0,14,10,8"/>
    <Button x:Name="ReceiptButton" Content="Record Accepted Receipt" Click="Receipt_Click" Padding="14,6" Margin="0,14,10,8"/>
    <Button x:Name="ExportButton" Content="Export / Print PDF" Click="Export_Click" IsEnabled="False" Padding="14,6" Margin="0,14,10,8"/>
   </WrapPanel>
   <TextBlock Text="Missing lab receipt dates remain 'Not recorded'. Registration date is not substituted for lab receipt. Cancelled and rejected records remain visible with their status." TextWrapping="Wrap" Foreground="#526371"/>
  </StackPanel>
  <DataGrid Grid.Row="2" x:Name="RegisterGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" AlternatingRowBackground="#EAF0F6" HeadersVisibility="Column">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Type" Binding="{Binding SampleType}" Width="170"/>
    <DataGridTextColumn Header="Sample No." Binding="{Binding SampleNumber}" Width="155"/>
    <DataGridTextColumn Header="Sample / source" Binding="{Binding Description}" Width="260"/>
    <DataGridTextColumn Header="Batch / lot" Binding="{Binding BatchOrLot}" Width="120"/>
    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100"/>
    <DataGridTextColumn Header="Sampled" Binding="{Binding SamplingDateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
    <DataGridTextColumn Header="Lab received" Binding="{Binding ReceivedDateTime, StringFormat=yyyy-MM-dd HH:mm, TargetNullValue=Not recorded}" Width="145"/>
    <DataGridTextColumn Header="Registered" Binding="{Binding RegisteredDateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
    <DataGridTextColumn Header="Sampled by" Binding="{Binding SampledBy}" Width="120"/>
    <DataGridTextColumn Header="Received by" Binding="{Binding ReceivedBy}" Width="120"/>
    <DataGridTextColumn Header="Registered by" Binding="{Binding RegisteredBy}" Width="120"/>
    <DataGridTextColumn Header="Receipt decision" Binding="{Binding ReceiptDecision}" Width="130"/>
    <DataGridTextColumn Header="Tests / EM plates" Binding="{Binding Tests}" Width="280"/>
    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="3" x:Name="RegisterStatus" Text="Choose the type and period, then Load Register." Margin="0,12,0,0" TextWrapping="Wrap"/>
 </Grid>
</Window>
