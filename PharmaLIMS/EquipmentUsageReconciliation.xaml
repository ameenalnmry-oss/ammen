<Window x:Class="PharmaLIMS.EquipmentUsageReconciliation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historical Equipment Usage Reconciliation"
        Width="1180" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F4F7FA">
    <Window.Resources>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#14233A" CornerRadius="10" Padding="18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Historical Equipment Usage Reconciliation" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Controlled QA documentation for eligible historical evidence gaps only. This workflow never rewrites a result, never backdates a signature, and never creates a retrospective current equipment assignment."
                           Foreground="#FDE68A" TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#D8E2EA" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Eligible unresolved evidence gaps" FontSize="17" FontWeight="Bold" Margin="4,2,0,10"/>
                    <DataGrid Grid.Row="1" x:Name="gridCandidates" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                              SelectionChanged="gridCandidates_SelectionChanged" RowHeaderWidth="0"
                              AlternatingRowBackground="#F8FAFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="75"/>
                            <DataGridTextColumn Header="Record" Binding="{Binding RecordReference}" Width="180"/>
                            <DataGridTextColumn Header="Result ID" Binding="{Binding ResultRecordID}" Width="80"/>
                            <DataGridTextColumn Header="Test / activity" Binding="{Binding TestName}" Width="*"/>
                            <DataGridTextColumn Header="Entered" Binding="{Binding ResultEnteredText}" Width="125"/>
                            <DataGridTextColumn Header="Gap" Binding="{Binding GapDescription}" Width="250"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#D8E2EA" BorderThickness="1" CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Controlled reconciliation evidence" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="lblSelected" Text="Select an eligible finding." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="Historically used equipment *"/>
                        <ComboBox x:Name="cboEquipment" Height="34" Margin="0,4,0,10" DisplayMemberPath="DisplayName"/>
                        <TextBlock Text="Controlled evidence reference *"/>
                        <TextBox x:Name="txtEvidenceReference" Height="34" Padding="8,5" Margin="0,4,0,10"/>
                        <TextBlock Text="Evidence summary *"/>
                        <TextBox x:Name="txtEvidenceSummary" Height="100" Padding="8" Margin="0,4,0,10"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="Reconciliation reason *"/>
                        <TextBox x:Name="txtReason" Height="90" Padding="8" Margin="0,4,0,10"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,2,0,12">
                            <TextBlock Text="Current equipment readiness is shown only as present-day context. The signer must cite controlled historical evidence that supports the equipment actually used at the time of the result."
                                       Foreground="#1E3A8A" TextWrapping="Wrap"/>
                        </Border>
                        <Button x:Name="BtnSignSave" Content="Sign and Save Reconciliation" Click="BtnSignSave_Click"
                                Style="{StaticResource Action}" Background="#176B87" Foreground="White" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="lblStatus" Foreground="#64748B" VerticalAlignment="Center" Text="No reconciliation saved in this session."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Refresh" Click="BtnRefresh_Click" Style="{StaticResource Action}" Background="#E2E8F0" Foreground="#334155"/>
                <Button Content="Close" Click="BtnClose_Click" Style="{StaticResource Action}" Background="#334155" Foreground="White" Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>