<Window x:Class="PharmaLIMS.SampleDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:PharmaLIMS.Infrastructure"
        Title="Sample Details"
        Height="760"
        Width="1180"
        WindowStartupLocation="CenterOwner" WindowState="Maximized" ResizeMode="CanResizeWithGrip"
        infra:WindowUsability.EnableResponsiveEntry="True"
        Background="#F4F6F8"
        MinHeight="650"
        MinWidth="1050">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#1F2937" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Sample Details" FontSize="21" FontWeight="Bold" Foreground="White" />
                    <TextBlock x:Name="txtHeaderSubtitle" Text="View complete sample lifecycle and current situation" Foreground="#D1D5DB" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnRefresh" Content="Refresh" Style="{StaticResource ActionButton}" Click="BtnRefresh_Click" />
                    <Button x:Name="btnEnterResults" Content="Enter Results" Style="{StaticResource ActionButton}" Click="BtnEnterResults_Click" />
                    <Button x:Name="btnOpenInvestigation" Content="Investigation" Style="{StaticResource ActionButton}" Click="BtnOpenInvestigation_Click" />
                    <Button x:Name="btnViewCOA" Content="COA" Style="{StaticResource ActionButton}" Click="BtnViewCOA_Click" />
                    <Button x:Name="btnClose" Content="Close" Style="{StaticResource ActionButton}" Click="BtnClose_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sample Header -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,8">
                    <TextBlock Text="Sample Number" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtSampleNumber" Text="-" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,12,8">
                    <TextBlock Text="Sample Type" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtSampleType" Text="-" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,12,8">
                    <TextBlock Text="Sampling Point" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtPointCode" Text="-" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Grid.Row="0" Margin="0,0,12,8">
                    <TextBlock Text="Location" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtLocation" Text="-" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Grid.Row="0" Margin="0,0,12,8">
                    <TextBlock Text="Sampling Date/Time" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtSamplingDateTime" Text="-" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="5" Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Current Status" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtCurrentStatus" Text="-" Style="{StaticResource ValueText}" />
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,12,0">
                    <TextBlock Text="Sampled By" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtSampledBy" Text="-" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,12,0">
                    <TextBlock Text="Created Date" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtCreatedDate" Text="-" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="4">
                    <TextBlock Text="Remarks / Activity" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtRemarks" Text="-" Style="{StaticResource ValueText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Current Situation -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Current Stage" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtStage" Text="-" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Total Tests" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtTotalTests" Text="0" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Completed" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtCompleted" Text="0" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Pending" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtPending" Text="0" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="Alert / Fail" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtAlertFail" Text="0 / 0" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="0,0,10,0">
                    <TextBlock Text="Investigation" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtInvestigationStatus" Text="-" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="6" Margin="0,0,10,0">
                    <TextBlock Text="COA" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtCOAStatus" Text="-" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="7">
                    <TextBlock Text="Next Required Action" Style="{StaticResource SmallLabel}" />
                    <TextBlock x:Name="txtNextAction" Text="-" Style="{StaticResource ValueText}" Foreground="#B45309" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="3" Background="White">
            <TabItem Header="Tests &amp; Results">
                <Grid Margin="8">
                    <DataGrid x:Name="dgTests">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Test Name" Binding="{Binding TestName}" Width="180" />
                            <DataGridTextColumn Header="Category" Binding="{Binding TestCategory}" Width="120" />
                            <DataGridTextColumn Header="Result" Binding="{Binding ResultValue}" Width="90" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80" />
                            <DataGridTextColumn Header="Alert" Binding="{Binding AlertLimit}" Width="75" />
                            <DataGridTextColumn Header="Action" Binding="{Binding ActionLimit}" Width="75" />
                            <DataGridTextColumn Header="Status" Binding="{Binding ResultStatus}" Width="90" />
                            <DataGridTextColumn Header="Entered By" Binding="{Binding EnteredBy}" Width="120" />
                            <DataGridTextColumn Header="Entered Date" Binding="{Binding EnteredDate}" Width="145" />
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Timeline">
                <Grid Margin="8">
                    <DataGrid x:Name="dgTimeline">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Step / Status" Binding="{Binding Status}" Width="170" />
                            <DataGridTextColumn Header="Performed By" Binding="{Binding PerformedBy}" Width="140" />
                            <DataGridTextColumn Header="Performed At" Binding="{Binding PerformedAt}" Width="160" />
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Investigations">
                <Grid Margin="8">
                    <DataGrid x:Name="dgInvestigations">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Investigation No" Binding="{Binding InvestigationNo}" Width="160" />
                            <DataGridTextColumn Header="Related Test" Binding="{Binding RelatedTest}" Width="170" />
                            <DataGridTextColumn Header="Deviation Type" Binding="{Binding DeviationType}" Width="140" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Opened By" Binding="{Binding OpenedBy}" Width="120" />
                            <DataGridTextColumn Header="Opened Date" Binding="{Binding OpenedDate}" Width="150" />
                            <DataGridTextColumn Header="Closed By" Binding="{Binding ClosedBy}" Width="120" />
                            <DataGridTextColumn Header="Closed Date" Binding="{Binding ClosedDate}" Width="150" />
                            <DataGridTextColumn Header="Required Action" Binding="{Binding RequiredAction}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="COA">
                <Grid Margin="8">
                    <DataGrid x:Name="dgCOA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Certificate No" Binding="{Binding CertificateNumber}" Width="180" />
                            <DataGridTextColumn Header="Status" Binding="{Binding CertificateStatus}" Width="110" />
                            <DataGridTextColumn Header="Revision" Binding="{Binding RevisionNo}" Width="80" />
                            <DataGridTextColumn Header="Issue Date" Binding="{Binding IssueDate}" Width="150" />
                            <DataGridTextColumn Header="Issued By" Binding="{Binding IssuedBy}" Width="120" />
                            <DataGridTextColumn Header="Cancelled" Binding="{Binding IsCancelled}" Width="90" />
                            <DataGridTextColumn Header="Cancellation Reason" Binding="{Binding CancellationReason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Audit Trail">
                <Grid Margin="8">
                    <DataGrid x:Name="dgAuditTrail">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Action" Binding="{Binding ActionType}" Width="150" />
                            <DataGridTextColumn Header="Field" Binding="{Binding FieldName}" Width="130" />
                            <DataGridTextColumn Header="Old Value" Binding="{Binding OldValue}" Width="140" />
                            <DataGridTextColumn Header="New Value" Binding="{Binding NewValue}" Width="140" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="180" />
                            <DataGridTextColumn Header="By" Binding="{Binding PerformedBy}" Width="120" />
                            <DataGridTextColumn Header="At" Binding="{Binding PerformedAt}" Width="150" />
                            <DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Signatures">
                <Grid Margin="8">
                    <DataGrid x:Name="dgSignatures">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Action Type" Binding="{Binding ActionType}" Width="160" />
                            <DataGridTextColumn Header="Meaning" Binding="{Binding MeaningOfSignature}" Width="200" />
                            <DataGridTextColumn Header="Signed By" Binding="{Binding SignedBy}" Width="140" />
                            <DataGridTextColumn Header="Role" Binding="{Binding UserRole}" Width="120" />
                            <DataGridTextColumn Header="Signed At" Binding="{Binding SignedAt}" Width="150" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding ActionReason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Status -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblStatus" Text="Ready" VerticalAlignment="Center" Foreground="#374151" />
            <ProgressBar x:Name="progressBar" Grid.Column="1" Width="180" Height="12" IsIndeterminate="True" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
