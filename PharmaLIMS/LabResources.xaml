<Window x:Class="PharmaLIMS.LabResources"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laboratory Resources / Equipment Management"
        Width="1420" Height="860" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#EEF3F7">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#164B6A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#475569"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,12,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#123E5A" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Laboratory Resources" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Controlled equipment master, qualification and calibration readiness"
                               Foreground="#C9DEE9" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E0F2FE" CornerRadius="16" Padding="12,6">
                        <TextBlock x:Name="LblSummary" Text="Loading equipment readiness..." Foreground="#075985" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearch" Height="36" Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Search by code, name, type, serial number, location, or status"
                                 TextChanged="TxtSearch_TextChanged"/>
                        <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Click="BtnRefresh_Click"/>
                    </Grid>

                    <DataGrid x:Name="GridEquipment" Grid.Row="1" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single"
                              SelectionChanged="GridEquipment_SelectionChanged"
                              CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8FAFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding EquipmentCode}" Width="110"/>
                            <DataGridTextColumn Header="Equipment" Binding="{Binding EquipmentName}" Width="190"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding EquipmentType}" Width="130"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding EquipmentStatus}" Width="120"/>
                            <DataGridTextColumn Header="Calibration" Binding="{Binding EffectiveCalibrationStatus}" Width="120"/>
                            <DataGridTextColumn Header="Qualification" Binding="{Binding EffectiveQualificationStatus}" Width="125"/>
                            <DataGridTextColumn Header="Use" Binding="{Binding UseReadiness}" Width="90"/>
                            <DataGridTextColumn Header="Next Cal." Binding="{Binding NextCalibrationDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="Next Qual." Binding="{Binding NextQualificationDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Equipment Master Record" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock x:Name="LblMode" Text="New record" Foreground="#64748B" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="New" Style="{StaticResource SecondaryButton}" Click="BtnNew_Click"/>
                        </Grid>

                        <UniformGrid Columns="2">
                            <StackPanel><TextBlock Text="Equipment Code *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtCode" Style="{StaticResource Field}"/></StackPanel>
                            <StackPanel><TextBlock Text="Equipment Name *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtName" Style="{StaticResource Field}"/></StackPanel>
                            <StackPanel><TextBlock Text="Equipment Type *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtType" Style="{StaticResource Field}"/></StackPanel>
                            <StackPanel><TextBlock Text="Department" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtDepartment" Style="{StaticResource Field}"/></StackPanel>
                            <StackPanel><TextBlock Text="Location" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtLocation" Style="{StaticResource Field}"/></StackPanel>
                            <StackPanel><TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtManufacturer" Style="{StaticResource Field}"/></StackPanel>
                            <StackPanel><TextBlock Text="Model" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtModel" Style="{StaticResource Field}"/></StackPanel>
                            <StackPanel><TextBlock Text="Serial Number" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtSerial" Style="{StaticResource Field}"/></StackPanel>
                        </UniformGrid>

                        <Separator Margin="0,4,0,12"/>

                        <UniformGrid Columns="2">
                            <StackPanel>
                                <TextBlock Text="Equipment Status *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboStatus" Style="{StaticResource Field}">
                                    <ComboBoxItem Content="Active"/><ComboBoxItem Content="Out of Service"/>
                                    <ComboBoxItem Content="Under Maintenance"/><ComboBoxItem Content="Quarantine"/>
                                    <ComboBoxItem Content="Retired"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Qualification Status *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboQualification" Style="{StaticResource Field}">
                                    <ComboBoxItem Content="Qualified"/><ComboBoxItem Content="Due Soon"/>
                                    <ComboBoxItem Content="Expired"/><ComboBoxItem Content="Not Qualified"/>
                                    <ComboBoxItem Content="Not Required"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel><TextBlock Text="Last Qualification" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="DpLastQualification" Style="{StaticResource Field}"/></StackPanel>
                            <StackPanel><TextBlock Text="Next Qualification" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="DpNextQualification" Style="{StaticResource Field}"/></StackPanel>
                            <StackPanel>
                                <TextBlock Text="Calibration Status *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboCalibration" Style="{StaticResource Field}">
                                    <ComboBoxItem Content="Calibrated"/><ComboBoxItem Content="Due Soon"/>
                                    <ComboBoxItem Content="Expired"/><ComboBoxItem Content="Not Calibrated"/>
                                    <ComboBoxItem Content="Not Required"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel><TextBlock Text="Last Calibration" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="DpLastCalibration" Style="{StaticResource Field}"/></StackPanel>
                            <StackPanel><TextBlock Text="Next Calibration" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="DpNextCalibration" Style="{StaticResource Field}"/></StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,12,0,0">
                                <CheckBox x:Name="ChkCalibrationRequired" Content="Calibration required" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkGmpCritical" Content="GMP critical equipment"/>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Method / SOP Reference" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtMethodReference" Height="34" Margin="0,0,0,10"/>

                        <TextBlock Text="Controlled Operational Uses" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtControlledUses"
                                 Height="92"
                                 Margin="0,0,0,10"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#F8FAFC"
                                 ToolTip="Read-only controlled use matrix. Result-level compatibility is enforced separately where a direct one-to-one rule is approved."/>

                        <Separator Margin="0,8,0,12"/>
                        <TextBlock Text="New Equipment Activity Draft" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,7"/>
                        <TextBlock Text="Creates a draft record only. Actual equipment use must be confirmed separately." Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2">
                            <StackPanel><TextBlock Text="Activity Type" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboActivityType" Height="34" Margin="0,0,8,10">
                                    <ComboBoxItem Content="Use"/>
                                    <ComboBoxItem Content="Incubation"/>
                                    <ComboBoxItem Content="Calibration"/>
                                    <ComboBoxItem Content="Periodic Verification"/>
                                    <ComboBoxItem Content="Cleaning"/>
                                    <ComboBoxItem Content="Sanitization"/>
                                    <ComboBoxItem Content="Maintenance"/>
                                    <ComboBoxItem Content="Breakdown"/>
                                    <ComboBoxItem Content="Repair"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel><TextBlock Text="Method / SOP reference" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtActivityMethod" Height="34" Margin="0,0,0,10"/>
                            </StackPanel>
                        </UniformGrid>
                        <Button Content="Create Activity Draft" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,12" Click="BtnCreateActivityDraft_Click"/>
                        <TextBlock Text="Link Draft to Actual Laboratory Test" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,7"/>
                        <UniformGrid Columns="2">
                            <StackPanel><TextBlock Text="Activity ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtActivityId" Height="32" Margin="0,0,8,8"/></StackPanel>
                            <StackPanel><TextBlock Text="Source Module" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CboSourceModule" Height="32" Margin="0,0,0,8">
                                    <ComboBoxItem Content="PRM"/><ComboBoxItem Content="EM"/><ComboBoxItem Content="WATER"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel><TextBlock Text="Sample / Event ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtSourceParentId" Height="32" Margin="0,0,8,8"/></StackPanel>
                            <StackPanel><TextBlock Text="Test / Plate ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TxtSourceResultId" Height="32" Margin="0,0,0,8"/></StackPanel>
                        </UniformGrid>
                        <Button Content="Link to Test" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12" Click="BtnLinkActivity_Click"/>
                        <Separator Margin="0,8,0,12"/>
                        <TextBlock Text="Equipment Activity History" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6"/>
                        <TextBlock x:Name="LblActivityHistory" Text="Select an equipment record to view its activity history." Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <DataGrid x:Name="GridActivityHistory" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" MinHeight="125" MaxHeight="220" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Activity ID" Binding="{Binding ActivityID}" Width="80"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding ActivityType}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding ActivityStatus}" Width="92"/>
                                <DataGridTextColumn Header="Performed By" Binding="{Binding PerformedBy}" Width="110"/>
                                <DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedAt}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtNotes" Height="64" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"/>

                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                            <TextBlock Text="A record becomes unavailable for laboratory use when it is not Active, qualification is expired/not qualified, or required calibration is expired/not calibrated. Changes require electronic signature."
                                       TextWrapping="Wrap" Foreground="#475569" FontSize="11"/>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save with E-Signature" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
                            <Button Content="Reload" Style="{StaticResource SecondaryButton}" Click="BtnReload_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#E2E8F0" Padding="14,0">
            <TextBlock x:Name="LblStatus" Text="Ready" VerticalAlignment="Center" Foreground="#475569"/>
        </Border>
    </Grid>
</Window>