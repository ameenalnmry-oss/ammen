<Window x:Class="PharmaLIMS.ExternalTrendThreeCycleReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:infra="clr-namespace:PharmaLIMS.Infrastructure"
        Title="External Environmental Monitoring Trend Review"
        Height="900" Width="1320" MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterOwner" WindowState="Maximized" ResizeMode="CanResizeWithGrip"
        infra:WindowUsability.EnableResponsiveEntry="True"
        Background="#F8FAFC" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="31"/>
            <Setter Property="MinWidth" Value="180"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="6,3,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F4C5C" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="External Environmental Monitoring — Trend Review" FontSize="21" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Controlled comparison of QA-approved external EM observations. Select the population, area scope, method, parameter and review period; the report retains each area as a separate controlled assessment."
                           Foreground="#D9F3F4" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="1" Header="Controlled review selection" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Width="220" Margin="0,0,12,6">
                        <TextBlock Text="Classification" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cboPopulation" Style="{StaticResource FieldCombo}" SelectionChanged="CboPopulation_SelectionChanged">
                            <ComboBoxItem Content="All classifications" Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="ISO 8 Production" Tag="ISO 8 Production"/>
                            <ComboBoxItem Content="Unclassified" Tag="Unclassified"/>
                            <ComboBoxItem Content="Classification Required (legacy)" Tag="Classification Required"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Width="330" Margin="0,0,12,6">
                        <TextBlock Text="Area" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cboArea" Style="{StaticResource FieldCombo}" DisplayMemberPath="Display" SelectedValuePath="AreaCode" SelectionChanged="CboArea_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Width="250" Margin="0,0,12,6">
                        <TextBlock Text="Method" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cboMethod" Style="{StaticResource FieldCombo}" DisplayMemberPath="MethodName" SelectedValuePath="MethodName" SelectionChanged="CboMethod_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Width="280" Margin="0,0,12,6">
                        <TextBlock Text="Result / parameter" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cboParameter" Style="{StaticResource FieldCombo}" DisplayMemberPath="ParameterName" SelectedValuePath="ParameterName" SelectionChanged="CboParameter_SelectionChanged"/>
                    </StackPanel>
                </WrapPanel>

                <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                    <TextBlock x:Name="lblProfile" Foreground="#334155" TextWrapping="Wrap"/>
                </Border>

                <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                    <StackPanel Width="220" Margin="0,0,12,6">
                        <TextBlock Text="Review scope" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cboReviewScope" Style="{StaticResource FieldCombo}" SelectionChanged="ReviewScopeChanged">
                            <ComboBoxItem Content="Custom date range" Tag="Custom" IsSelected="True"/>
                            <ComboBoxItem Content="One cycle" Tag="1"/>
                            <ComboBoxItem Content="Two cycles" Tag="2"/>
                            <ComboBoxItem Content="Three cycles" Tag="3"/>
                            <ComboBoxItem Content="Full year" Tag="Year"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="pnlCycleLength" Width="180" Margin="0,0,12,6" Visibility="Collapsed">
                        <TextBlock Text="Cycle length" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cboCycleMonths" Style="{StaticResource FieldCombo}" SelectionChanged="ReviewScopeChanged">
                            <ComboBoxItem Content="1 month" Tag="1"/>
                            <ComboBoxItem Content="3 months" Tag="3"/>
                            <ComboBoxItem Content="6 months" Tag="6" IsSelected="True"/>
                            <ComboBoxItem Content="12 months" Tag="12"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Width="190" Margin="0,0,12,6">
                        <TextBlock x:Name="lblStartDateCaption" Text="From date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="dpReviewStart" Height="31" SelectedDateChanged="ReviewEndDateChanged"/>
                    </StackPanel>
                    <StackPanel Width="190" Margin="0,0,12,6">
                        <TextBlock Text="Review end date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="dpReviewEnd" Height="31" SelectedDateChanged="ReviewEndDateChanged"/>
                    </StackPanel>
                    <StackPanel Width="250" Margin="0,20,12,6">
                        <Button x:Name="btnGenerateReview" Content="Generate review report(s)" Click="LoadComparison_Click" Height="33" Background="#2563EB" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,20,12,6">
                        <Button x:Name="btnOpenImportApproval" Content="Import / Approve Data" Click="OpenImportApproval_Click" Height="33"/>
                    </StackPanel>
                </WrapPanel>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Periods" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="lblPeriods" Grid.Column="1" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Text="Review basis" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="lblReviewBasis" Grid.Row="1" Grid.Column="1"
                               Text="Choose any From and To dates. One-, two- and three-cycle views are optional comparisons; the selected periods are recorded in the approved snapshot."
                               Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock x:Name="lblDateValidation" Grid.Row="2" Grid.Column="1" Foreground="#B91C1C" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </GroupBox>

        <TabControl x:Name="tabsReview" Grid.Row="2" Margin="0,0,0,8">
            <TabItem Header="Visual Trend">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="lblChartHint" Text="For All Areas, select any row in Period Summary to display that area's selected-period chart."
                               Foreground="#475569" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <oxy:PlotView x:Name="TrendChart" Grid.Row="1" MinHeight="250"/>
                </Grid>
            </TabItem>

            <TabItem Header="Period Summary">
                <DataGrid x:Name="dgSummary" Margin="8" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="DgSummary_SelectionChanged"
                          FrozenColumnCount="2" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Signal}" Value="Action"><Setter Property="Background" Value="#FECACA"/></DataTrigger>
                                <DataTrigger Binding="{Binding Signal}" Value="Alert"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger>
                                <DataTrigger Binding="{Binding Signal}" Value="Not Assessed"><Setter Property="Background" Value="#E2E8F0"/></DataTrigger>
                                <DataTrigger Binding="{Binding Signal}" Value="No Data"><Setter Property="Foreground" Value="#64748B"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="145"/>
                        <DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="220"/>
                        <DataGridTextColumn Header="n" Binding="{Binding Observations}" Width="55"/>
                        <DataGridTextColumn Header="Minimum" Binding="{Binding Minimum, StringFormat={}{0:0.##}}" Width="78"/>
                        <DataGridTextColumn Header="Mean" Binding="{Binding Mean, StringFormat={}{0:0.##}}" Width="72"/>
                        <DataGridTextColumn Header="Median" Binding="{Binding Median, StringFormat={}{0:0.##}}" Width="72"/>
                        <DataGridTextColumn Header="Maximum" Binding="{Binding Maximum, StringFormat={}{0:0.##}}" Width="78"/>
                        <DataGridTextColumn Header="Alert limit" Binding="{Binding AlertLimit, StringFormat={}{0:0.##}}" Width="82"/>
                        <DataGridTextColumn Header="Alert n" Binding="{Binding AlertCount}" Width="65"/>
                        <DataGridTextColumn Header="Alert %" Binding="{Binding AlertRate, StringFormat={}{0:0.#}}" Width="70"/>
                        <DataGridTextColumn Header="Action limit" Binding="{Binding ActionLimit, StringFormat={}{0:0.##}}" Width="86"/>
                        <DataGridTextColumn Header="Action n" Binding="{Binding ActionCount}" Width="70"/>
                        <DataGridTextColumn Header="Action %" Binding="{Binding ActionRate, StringFormat={}{0:0.#}}" Width="74"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="85"/>
                        <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="105"/>
                        <DataGridTextColumn Header="Data quality" Binding="{Binding DataQuality}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Interpretation / QA">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="txtNarrative" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" FontSize="13" Background="White" BorderBrush="#CBD5E1" Padding="9"/>
                    <TextBlock Grid.Row="1" Text="QA reviewer comment" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                    <TextBox x:Name="txtReviewerComment" Grid.Row="2" Height="58" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             ToolTip="QA reviewer comment saved with the immutable review snapshot."/>
                    <TextBlock Grid.Row="3" Margin="0,8,0,0"
                               Text="Decision support only: assess excursions, directional trend, data completeness, organism/location recurrence and facility/process context under the approved EM procedure. Automated interpretation does not replace QA judgement, deviation/CAPA assessment, or the approved monitoring programme."
                               Foreground="#475569" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="lblStatus" Foreground="#475569" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="progressLoad" Width="180" Height="14" Margin="0,5,0,0" HorizontalAlignment="Left" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="chkIncludeAreaPages" Margin="6,0,8,0" VerticalAlignment="Center"
                              Content="Include chart page for every area" IsChecked="False"
                              ToolTip="For All Areas, the default PDF is a concise portfolio summary. Select this only when the full area-by-area chart pack is required."/>
                    <Button Content="Export Excel CSV" Click="ExportCsv_Click" Style="{StaticResource ActionButton}"/>
                    <Button Content="Export PDF" Click="ExportPdf_Click" Style="{StaticResource ActionButton}"/>
                    <Button x:Name="btnApproveSnapshot" Content="QA Approve Snapshot" Click="SaveSnapshot_Click"
                            Style="{StaticResource ActionButton}" MinWidth="155" Background="#0F766E" Foreground="White" FontWeight="SemiBold"
                            ToolTip="Electronically approve and save immutable External EM trend review snapshot(s)."/>
                    <Button x:Name="btnCancel" Content="Cancel" Click="Cancel_Click" Style="{StaticResource ActionButton}" IsEnabled="False"/>
                    <Button Content="Close" Click="Close_Click" Style="{StaticResource ActionButton}"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
