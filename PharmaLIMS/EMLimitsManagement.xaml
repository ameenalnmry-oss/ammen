<Window x:Class="PharmaLIMS.EMLimitsManagement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:PharmaLIMS.Infrastructure"
        Title="Approved EM Limits"
        Width="760"
        Height="610"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="CanResizeWithGrip"
        infra:WindowUsability.EnableResponsiveEntry="True"
        Background="#EEF2F7"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#12395A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D8E0EA"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <EventSetter Event="SelectionChanged" Handler="SelectionChanged_LoadLimit"/>
        </Style>
        <Style TargetType="Button" x:Key="BaseButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style TargetType="Button" x:Key="SuccessButton" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>
        <Style TargetType="Button" x:Key="GrayButton" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#64748B"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,18" CornerRadius="0,0,18,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" Background="White" CornerRadius="12" Margin="0,0,14,0">
                    <TextBlock Text="EM" Foreground="{StaticResource PrimaryBrush}" FontSize="16" FontWeight="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Approved EM Limits" Foreground="White" FontWeight="Bold" FontSize="22"/>
                    <TextBlock Text="Record site-approved Alert and Action limits for Environmental Monitoring methods."
                               Foreground="#D7E9FA" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="22">
                <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Controlled master data" Foreground="#9A3412" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#7C2D12"
                                   Text="Enter only limits that are already approved by the site SOP / CCS / change-control process. PharmaLIMS does not invent or scientifically approve these limits. Saving requires Settings permission and a password-backed electronic signature."/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Class / Grade" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="cboGrade" IsEditable="False"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Monitoring Method" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="cboMethod" IsEditable="False"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Alert Limit" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtAlertLimit"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Action Limit" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtActionLimit"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Result Unit" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtUnit" IsReadOnly="True" Background="#F8FAFC"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Air Volume (L) - Active Air only" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtAirVolume"/>
                        </StackPanel>

                        <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Current record" Foreground="#475569" FontWeight="Bold" FontSize="12"/>
                                <TextBlock x:Name="lblCurrentRecord" Text="Select a grade and method." Margin="0,5,0,0" Foreground="#0F172A" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock x:Name="lblStatus" Text="Ready" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reload" Click="BtnReload_Click" Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BtnSave" Content="Record Approved Limits" Click="BtnSave_Click" Style="{StaticResource SuccessButton}" MinWidth="190"/>
                <Button Content="Close" Click="BtnClose_Click" Style="{StaticResource GrayButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
