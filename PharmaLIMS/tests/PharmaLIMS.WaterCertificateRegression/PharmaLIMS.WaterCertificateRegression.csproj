<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Services/ControlledNumericValue.cs" Link="Production/ControlledNumericValue.cs" />
    <Compile Include="../../Services/WaterNumericResultEvaluator.cs" Link="Production/WaterNumericResultEvaluator.cs" />
  </ItemGroup>
  <Target Name="ExtractCertificateMethods" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/extract_report_methods.py&quot; &quot;$(MSBuildProjectDirectory)/../../ReportCertificate.xaml.cs&quot; &quot;$(IntermediateOutputPath)CertificateMethods.g.cs&quot;" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)CertificateMethods.g.cs" /></ItemGroup>
  </Target>
</Project>
