<Window x:Class="PharmaLIMS.EMCollectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EM Sample Collection" Height="760" Width="1180" MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterOwner" WindowState="Maximized" ResizeMode="CanResizeWithGrip"
        Background="#EEF3F7" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Height" Value="39"/><Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,5,12,12"/><Setter Property="BorderBrush" Value="#C8D5DF"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Height" Value="42"/><Setter Property="MinWidth" Value="125"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="6"/><Setter Property="Background" Value="#176B87"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Background" Value="#DFEAF0"/><Setter Property="Foreground" Value="#17354B"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#103B5B" Padding="24,13">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Controlled EM Sample Collection" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock x:Name="lblPlan" Foreground="#BCD5E3" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1A5274" CornerRadius="16" Padding="15,8" VerticalAlignment="Center">
                    <TextBlock x:Name="lblProgress" Foreground="White" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#D7E1E9" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,14,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Plan Samples" FontSize="17" FontWeight="Bold" Margin="4,2,0,10"/>
                    <ListBox x:Name="lstSamples" Grid.Row="1" SelectionChanged="lstSamples_SelectionChanged" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Padding="8" Margin="0,2" BorderBrush="#E0E7ED" BorderThickness="0,0,0,1">
                                <StackPanel><TextBlock Text="{Binding SampleCode, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Foreground="#61788B"><Run Text="{Binding AreaName, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding Method, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="White" BorderBrush="#D7E1E9" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <StackPanel><TextBlock Text="Sample identity" FontSize="18" FontWeight="Bold" Foreground="#15334A"/>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <StackPanel><TextBlock Text="Sample Code"/><TextBox x:Name="txtCode" Style="{StaticResource Field}" IsReadOnly="True" Background="#F1F5F8"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Area"/><TextBox x:Name="txtArea" Style="{StaticResource Field}" IsReadOnly="True" Background="#F1F5F8"/></StackPanel>
                                <StackPanel Grid.Row="1"><TextBlock Text="Method"/><TextBox x:Name="txtMethod" Style="{StaticResource Field}" IsReadOnly="True" Background="#F1F5F8"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Location"/><TextBox x:Name="txtLocation" Style="{StaticResource Field}" IsReadOnly="True" Background="#F1F5F8"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="#D7E1E9" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel><TextBlock Text="Collection checks and actual times" FontSize="18" FontWeight="Bold" Foreground="#15334A"/>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <StackPanel><TextBlock Text="Plate / Swab Condition *"/><ComboBox x:Name="cboPlateCondition" Style="{StaticResource Field}"><ComboBoxItem Content="Acceptable"/><ComboBoxItem Content="Damaged"/><ComboBoxItem Content="Expired"/></ComboBox></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Kit / Media Release Status *"/><ComboBox x:Name="cboKitCondition" Style="{StaticResource Field}"><ComboBoxItem Content="Released / Within Expiry"/><ComboBoxItem Content="Damaged"/><ComboBoxItem Content="Expired"/><ComboBoxItem Content="Not Released"/></ComboBox></StackPanel>
                                <StackPanel Grid.Row="1"><TextBlock Text="Sampling Start (yyyy-MM-dd HH:mm) *"/><TextBox x:Name="txtStart" Style="{StaticResource Field}"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Sampling End (yyyy-MM-dd HH:mm) *"/><TextBox x:Name="txtEnd" Style="{StaticResource Field}"/></StackPanel>
                                <StackPanel Grid.Row="2"><TextBlock Text="Transport Minimum °C *"/><TextBox x:Name="txtMin" Style="{StaticResource Field}"/></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="Transport Maximum °C *"/><TextBox x:Name="txtMax" Style="{StaticResource Field}"/></StackPanel>
                                <StackPanel x:Name="pnlControl" Grid.Row="3" Grid.ColumnSpan="2"><TextBlock Text="Negative Control Result *"/><ComboBox x:Name="cboControl" Style="{StaticResource Field}"><ComboBoxItem Content="No Growth"/><ComboBoxItem Content="Growth Detected"/></ComboBox></StackPanel>
                            </Grid>
                            <Border x:Name="validationBanner" Background="#FFF4E5" BorderBrush="#F4C26B" BorderThickness="1" CornerRadius="8" Padding="10" Visibility="Collapsed">
                                <TextBlock x:Name="lblValidation" Foreground="#8A4B08" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#D4DFE7" BorderThickness="0,1,0,0" Padding="10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Enter moves to the next field. Ctrl+Enter saves this sample and advances." Foreground="#60778A" VerticalAlignment="Center" Margin="8,0"/>
                <WrapPanel Grid.Column="1"><Button Content="Previous" Style="{StaticResource Secondary}" Click="Previous_Click"/><Button Content="Save &amp; Next" Style="{StaticResource Primary}" Click="Next_Click"/><Button Content="Finish Collection" Style="{StaticResource Primary}" Background="#159447" Click="Finish_Click"/><Button Content="Cancel" Style="{StaticResource Secondary}" Click="Cancel_Click"/></WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
