<Window x:Class="PharmaLIMS.ChangePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:PharmaLIMS.Infrastructure"
        Title="Change PharmaLIMS Password"
        Width="520" Height="520" MinWidth="480" MinHeight="470"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        infra:WindowUsability.EnableResponsiveEntry="True"
        Background="#F4F7FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#14233A" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Change Password" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock x:Name="LblAccount" Foreground="#C9D7E5" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#D8E2EA" BorderThickness="1" CornerRadius="10" Padding="18">
            <StackPanel>
                <TextBlock x:Name="LblRequirement" Text="A personal password is required before the PharmaLIMS workspace or Electronic Signature can be used."
                           TextWrapping="Wrap" Foreground="#334155" Margin="0,0,0,14"/>

                <TextBlock Text="Current / Temporary Password" FontWeight="SemiBold" Foreground="#334155"/>
                <PasswordBox x:Name="PwdCurrent" Height="36" Padding="8,5" Margin="0,5,0,14"/>

                <TextBlock Text="New Password" FontWeight="SemiBold" Foreground="#334155"/>
                <PasswordBox x:Name="PwdNew" Height="36" Padding="8,5" Margin="0,5,0,14"/>

                <TextBlock Text="Confirm New Password" FontWeight="SemiBold" Foreground="#334155"/>
                <PasswordBox x:Name="PwdConfirm" Height="36" Padding="8,5" Margin="0,5,0,10"/>

                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10">
                    <TextBlock Text="Password policy: at least 12 characters with upper-case, lower-case, number, and special character. It must not contain your username and must differ from the current password."
                               TextWrapping="Wrap" Foreground="#1E3A8A" FontSize="10.5"/>
                </Border>

                <TextBlock x:Name="LblError" Foreground="#B91C1C" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" Height="36" MinWidth="100" Margin="0,0,10,0"/>
            <Button x:Name="BtnChange" Content="Change Password" Click="BtnChange_Click" Height="36" MinWidth="150"
                    Background="#166534" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
