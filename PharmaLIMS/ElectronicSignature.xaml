<Window x:Class="PharmaLIMS.ElectronicSignature"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Electronic Signature"
        Height="740"
        Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        KeyDown="Window_KeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1E293B"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,18">
            <TextBlock Text="Electronic Signature"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Background="White"
                Padding="16"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Record:"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="lblSample"
                           Grid.Row="0" Grid.Column="1"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="User:"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="lblUser"
                           Grid.Row="1" Grid.Column="1"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Action:"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="lblAction"
                           Grid.Row="2" Grid.Column="1"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Date/Time:"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="lblDateTime"
                           Grid.Row="3" Grid.Column="1"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <StackPanel x:Name="pnlPassword">
                <TextBlock Text="Password:"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0,0,0,6"/>

                <PasswordBox x:Name="txtPassword"
                             Height="44"
                             FontSize="16"
                             Padding="8"
                             PasswordChanged="TxtPassword_PasswordChanged"/>

                <TextBlock x:Name="lblPasswordHelp"
                           Text="Enter the same PharmaLIMS password used to sign in for the account shown above."
                           Foreground="#94A3B8"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,8,0,18"/>
            </StackPanel>

            <TextBlock Text="Meaning of Signature:"
                       FontWeight="SemiBold"
                       Foreground="#475569"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="cboMeaning"
                      Height="44"
                      FontSize="15"
                      Padding="8"
                      Margin="0,0,0,18">
                <ComboBoxItem Content="I certify that this action is performed by me"/>
                <ComboBoxItem Content="I approve this action"/>
                <ComboBoxItem Content="I confirm this action"/>
                <ComboBoxItem Content="I have reviewed and verified this data"/>
            </ComboBox>

            <TextBlock Text="Reason for Action:"
                       FontWeight="SemiBold"
                       Foreground="#475569"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="cboReason"
                      Height="44"
                      FontSize="15"
                      Padding="8"
                      Margin="0,0,0,18">
                <ComboBoxItem Content="Routine data entry"/>
                <ComboBoxItem Content="Result entry"/>
                <ComboBoxItem Content="Review of data"/>
                <ComboBoxItem Content="Approval of results"/>
                <ComboBoxItem Content="Certificate issuance"/>
                <ComboBoxItem Content="Certificate cancellation"/>
                <ComboBoxItem Content="Correction of data entry error"/>
                <ComboBoxItem Content="Database maintenance"/>
            </ComboBox>

            <TextBlock x:Name="lblError"
                       Text=""
                       Foreground="#DC2626"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0">
            <Button x:Name="btnConfirm"
                    Content="Confirm"
                    Width="175"
                    Height="52"
                    Margin="0,0,16,0"
                    Background="#38BDF8"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    IsDefault="True"
                    Click="BtnConfirm_Click"/>

            <Button x:Name="btnCancel"
                    Content="Cancel"
                    Width="175"
                    Height="52"
                    Background="#EF4444"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    IsCancel="True"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>